# 默认本地演示，不调用模型、不需要 API Key。
AGENT_PROVIDER=mock
# 真实模式改为 openai_compatible，并配置你有权限使用的模型名。
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RESPONSE_FORMAT=json_schema
# 仅当服务不支持 JSON Schema 时设为 json_object；仍经 Pydantic 校验。

# 本地默认留空。部署到受控远端时设置足够长的随机口令，所有资料 API 均需 X-Agent-Token。
APP_ACCESS_TOKEN=
APP_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# 远端界面需明确填完整 HTTPS origin，例如 https://interview.example.org
APP_ALLOWED_ORIGINS=
# 私人资料目录，默认 .data/；不要提交、打包或公开挂载。
# JOB_AUTOFILL_DATA_DIR=/data
